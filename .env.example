# =========================
# Required (all environments)
# =========================
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=

# Core collection IDs (required)
VITE_APPWRITE_CLIENTS_COLLECTION_ID=
VITE_APPWRITE_GUARDS_COLLECTION_ID=
VITE_APPWRITE_SITES_COLLECTION_ID=
VITE_APPWRITE_POSTS_COLLECTION_ID=
VITE_APPWRITE_SHIFTS_COLLECTION_ID=
VITE_APPWRITE_SHIFT_ASSIGNMENTS_COLLECTION_ID=
VITE_APPWRITE_INCIDENTS_COLLECTION_ID=
VITE_APPWRITE_ASSETS_COLLECTION_ID=
VITE_APPWRITE_APPLICATIONS_COLLECTION_ID=
VITE_APPWRITE_STAFF_INVITES_COLLECTION_ID=
VITE_APPWRITE_STAFF_PROFILES_COLLECTION_ID=
VITE_APPWRITE_STAFF_COMPLIANCE_COLLECTION_ID=
VITE_APPWRITE_COMPLIANCE_UPLOADS_COLLECTION_ID=
VITE_APPWRITE_AUDIT_LOGS_COLLECTION_ID=audit_logs
VITE_APPWRITE_RECURRING_PATTERNS_COLLECTION_ID=

# Compliance V1 collection IDs (required only when VITE_ENABLE_COMPLIANCE_V1=true)
