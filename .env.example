VITE_APPWRITE_COMPLIANCE_SUBMISSIONS_COLLECTION_ID=
VITE_APPWRITE_DOCUMENT_INSTANCES_COLLECTION_ID=

# =========================
# Optional
# =========================
VITE_ENABLE_DEMO_MODE=false
VITE_ENABLE_COMPLIANCE_V1=false
VITE_APPWRITE_USERS_COLLECTION_ID=
VITE_APPWRITE_ADMIN_PROFILES_COLLECTION_ID=
VITE_APPWRITE_MANAGER_PROFILES_COLLECTION_ID=
